+function effectiveCodexBaseUrl(raw: string): string {
+  const trimmed = raw.trim();
+  try {
+    const parsed = new URL(trimmed);
+    const hostname = parsed.hostname.replace(/\.$/, "").toLowerCase();
+    const isPublicDnsHost = hostname && hostname !== "localhost" && !hostname.endsWith(".local") && !/^\d{1,3}(?:\.\d{1,3}){3}$/.test(hostname) && !hostname.includes(":");
+    if (parsed.protocol === "http:" && !parsed.port && isPublicDnsHost) {
+      parsed.protocol = "https:";
+      const normalized = parsed.toString();
+      return !trimmed.endsWith("/") && parsed.pathname === "/" && !parsed.search && !parsed.hash && normalized.endsWith("/")
+        ? normalized.slice(0, -1)
+        : normalized;
+    }
+  } catch {
+    return trimmed;
+  }
+  return trimmed;
+}
