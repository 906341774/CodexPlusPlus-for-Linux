+fn effective_codex_base_url(base_url: &str) -> String {
+    let trimmed = base_url.trim();
+    let Ok(mut parsed) = url::Url::parse(trimmed) else {
+        return trimmed.to_string();
+    };
+    if parsed.scheme() == "http" && parsed.port().is_none() && is_public_dns_host(parsed.host()) {
+        let _ = parsed.set_scheme("https");
+        let mut normalized = parsed.to_string();
+        if !trimmed.ends_with('/')
+            && parsed.path() == "/"
+            && parsed.query().is_none()
+            && parsed.fragment().is_none()
+            && normalized.ends_with('/')
+        {
+            normalized.pop();
+        }
+        return normalized;
+    }
+    trimmed.to_string()
+}
+
+fn is_public_dns_host(host: Option<Host<&str>>) -> bool {
+    let Some(Host::Domain(domain)) = host else {
+        return false;
+    };
+    let domain = domain.trim_end_matches('.').to_ascii_lowercase();
+    !matches!(domain.as_str(), "" | "localhost") && !domain.ends_with(".local")
+}
