+#[cfg(target_os = "linux")]
+fn linux_adapter_state_entrypoint_candidates(manager: bool) -> Vec<PathBuf> {
+    let Some(install_root) = linux_adapter_state_install_root() else {
+        return Vec::new();
+    };
+    linux_adapter_install_entrypoint_candidates(&install_root, manager)
+}
+
+#[cfg(target_os = "linux")]
+fn linux_adapter_state_install_root() -> Option<PathBuf> {
+    let state_path = linux_adapter_state_file()?;
+    let state_text = std::fs::read_to_string(state_path).ok()?;
+    let state: serde_json::Value = serde_json::from_str(&state_text).ok()?;
+    state
+        .get("linuxAdapterInstallRoot")
+        .and_then(serde_json::Value::as_str)
+        .filter(|value| !value.trim().is_empty())
+        .map(PathBuf::from)
+        .or_else(|| {
+            state
+                .get("appRoot")
+                .and_then(serde_json::Value::as_str)
+                .filter(|value| !value.trim().is_empty())
+                .map(|app_root| PathBuf::from(app_root).join(".codex-plusplus"))
+        })
+}
+
+#[cfg(target_os = "linux")]
+fn linux_adapter_state_file() -> Option<PathBuf> {
+    if let Some(value) = std::env::var_os("XDG_DATA_HOME").filter(|value| !value.is_empty()) {
+        return Some(
+            PathBuf::from(value)
+                .join("codex-plusplus")
+                .join("state.json"),
+        );
+    }
+    directories::BaseDirs::new()
+        .map(|dirs| dirs.data_dir().join("codex-plusplus").join("state.json"))
+}
+
+#[cfg(target_os = "linux")]
+fn linux_desktop_entry_candidates(manager: bool) -> Vec<PathBuf> {
+    let (silent, manager_entry) = desktop_entry_file_names();
+    let name = if manager { manager_entry } else { silent };
+    let Some(base_dirs) = directories::BaseDirs::new() else {
+        return Vec::new();
+    };
+    vec![base_dirs.data_dir().join("applications").join(name)]
+}
+
+#[cfg(target_os = "linux")]
+fn linux_adapter_install_entrypoint_candidates(install_root: &Path, manager: bool) -> Vec<PathBuf> {
+    let install_dir = install_root.join("install");
+    if manager {
+        vec![install_dir.join(MANAGER_BINARY)]
+    } else {
+        vec![
+            install_dir.join("launch-codex-plus-plus"),
+            install_dir.join(SILENT_BINARY),
+        ]
     }
 }

