+fn entrypoint_candidates_for_app(
+    root: &Option<PathBuf>,
+    app_dir: Option<&Path>,
+    manager: bool,
+) -> Vec<PathBuf> {
+    let mut candidates = Vec::new();
+    #[cfg(target_os = "linux")]
+    {
+        candidates.extend(linux_adapter_state_entrypoint_candidates(manager));
+        candidates.extend(linux_adapter_entrypoint_candidates(app_dir, manager));
+        candidates.extend(linux_desktop_entry_candidates(manager));
+    }
+    candidates.extend(entrypoint_candidates(root, manager));
+    dedupe_paths(candidates)
+}
+
+fn dedupe_paths(candidates: Vec<PathBuf>) -> Vec<PathBuf> {
+    let mut unique = Vec::new();
+    for candidate in candidates {
+        if !unique.iter().any(|path| path == &candidate) {
+            unique.push(candidate);
+        }
+    }
+    unique
+}
