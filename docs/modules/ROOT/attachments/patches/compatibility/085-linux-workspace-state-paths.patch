+fn is_windows_desktop_path(value: &str) -> bool {
+    let bytes = value.as_bytes();
+    value.starts_with(r"\\")
+        || (bytes.len() >= 2 && bytes[0].is_ascii_alphabetic() && bytes[1] == b':')
+}
+
+fn trim_posix_trailing_separators(path: &mut String) {
+    while path.len() > 1 && path.ends_with('/') {
+        path.pop();
+    }
+}
