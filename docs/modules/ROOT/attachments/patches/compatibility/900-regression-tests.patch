+                    row.get::<_, String>(0)?,
+                    row.get::<_, f64>(1)?,
+                    row.get::<_, f64>(2)?,
+                    row.get::<_, String>(3)?,
+                    row.get::<_, String>(4)?,
+                    row.get::<_, Option<String>>(5)?,
+                    row.get::<_, String>(6)?,
+                    row.get::<_, Option<String>>(7)?,
+                    row.get::<_, i64>(8)?,
+                ))
+            },
+        )
+        .unwrap();
+    assert_eq!(
+        row,
+        (
+            "Visible legacy thread".to_string(),
+            1700000000.0,
+            1700000060.0,
+            "/home/deck/workspace".to_string(),
+            "rollout".to_string(),
+            Some("/tmp/rollout-thread-visible.jsonl".to_string()),
+            "custom".to_string(),
+            Some("main".to_string()),
+            0,
+        )
+    );
+    let sync_state = db
+        .query_row(
+            "SELECT initial_build_complete, observation_sequence, watermark_updated_at FROM local_thread_catalog_sync_state WHERE host_id = 'local'",
+            [],
+            |row| {
+                Ok((
+                    row.get::<_, i64>(0)?,
+                    row.get::<_, i64>(1)?,
+                    row.get::<_, Option<f64>>(2)?,
+                ))
+            },
