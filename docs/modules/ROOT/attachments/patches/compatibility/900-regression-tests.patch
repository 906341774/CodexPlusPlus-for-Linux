+#[cfg(target_os = "linux")]
+struct EnvVarRestore {
+    key: &'static str,
+    old_value: Option<std::ffi::OsString>,
+}
+
+#[cfg(target_os = "linux")]
+impl Drop for EnvVarRestore {
+    fn drop(&mut self) {
+        if let Some(value) = self.old_value.take() {
+            unsafe { std::env::set_var(self.key, value) };
+        } else {
+            unsafe { std::env::remove_var(self.key) };
+        }
+    }
+}
