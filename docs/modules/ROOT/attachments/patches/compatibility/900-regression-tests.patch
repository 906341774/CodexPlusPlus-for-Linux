+    fs::write(home.join("config.toml"), "model_provider = \"apigather\"\n").unwrap();
+    create_state_db_with_project_threads(&home.join("state_5.sqlite"));
+    let catalog_path = sqlite_dir.join("codex-dev.db");
+    create_empty_local_thread_catalog(&catalog_path);
+
+    let result = run_provider_sync(Some(&home));
+
+    assert_eq!(result.status, ProviderSyncStatus::Synced);
+    let db = Connection::open(&catalog_path).unwrap();
+    let rows = db
+        .prepare(
+            "SELECT host_id, thread_id, display_title, source_created_at, source_updated_at, cwd, source_kind, source_detail, model_provider, git_branch, observation_sequence, missing_candidate FROM local_thread_catalog ORDER BY thread_id",
+        )
+        .unwrap()
+        .query_map([], |row| {
+            Ok((
+                row.get::<_, String>(0)?,
+                row.get::<_, String>(1)?,
+                row.get::<_, String>(2)?,
+                row.get::<_, f64>(3)?,
+                row.get::<_, f64>(4)?,
+                row.get::<_, String>(5)?,
+                row.get::<_, String>(6)?,
+                row.get::<_, Option<String>>(7)?,
+                row.get::<_, String>(8)?,
+                row.get::<_, Option<String>>(9)?,
+                row.get::<_, i64>(10)?,
+                row.get::<_, i64>(11)?,
+            ))
+        })
+        .unwrap()
+        .collect::<rusqlite::Result<Vec<_>>>()
+        .unwrap();
+    assert_eq!(
+        rows,
+        vec![(
+            "local".to_string(),
+            "thread-visible".to_string(),
+            "Visible project thread".to_string(),
+            1782000000.0,
+            1782000900.0,
+            "/home/deck/opt/CodexPlusPlus-on-Linux".to_string(),
+            "rollout".to_string(),
+            Some("/home/deck/.codex/sessions/2026/rollout-visible.jsonl".to_string()),
+            "apigather".to_string(),
+            Some("mian".to_string()),
+            14,
+            0,
+        )]
+    );
+    let sync_state = db
+        .query_row(
+            "SELECT watermark_updated_at, initial_build_complete, observation_sequence FROM local_thread_catalog_sync_state WHERE host_id = 'local'",
