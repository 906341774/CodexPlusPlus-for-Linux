+fn mark_unopenable_local_thread_catalog_rows_missing(
+    tx: &rusqlite::Transaction<'_>,
+    _threads: &[LocalCatalogThread],
+    observation_sequence: i64,
+) -> anyhow::Result<usize> {
+    Ok(tx.execute(
+        "UPDATE local_thread_catalog
+         SET missing_candidate = 1,
