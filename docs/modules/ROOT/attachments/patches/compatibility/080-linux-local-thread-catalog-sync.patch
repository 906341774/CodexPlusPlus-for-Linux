+        .map(|(complete, watermark)| {
+            complete != 1 || watermark != latest_local_catalog_updated_at(threads)
+        })
+        .unwrap_or(true);
+    if sync_state_needs_update {
+        total += 1;
+    }
+    Ok(total)
+}
