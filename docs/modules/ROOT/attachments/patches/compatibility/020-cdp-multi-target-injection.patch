+fn is_linux_local_codex_app_url(raw_url: &str) -> bool {
+    let Ok(url) = Url::parse(raw_url) else {
+        return false;
+    };
+
+    if !matches!(url.scheme(), "http" | "https") {
+        return false;
+    }
+
+    let Some(port) = url.port_or_known_default() else {
+        return false;
+    };
