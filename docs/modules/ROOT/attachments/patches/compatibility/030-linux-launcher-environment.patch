+#[cfg(target_os = "linux")]
+fn apply_linux_codex_plusplus_webview_environment(
+    app_dir: &Path,
+    env: &mut HashMap<String, String>,
+) {
+    if !app_dir.join("start.sh").exists() {
+        return;
+    }
+    env.entry("CODEX_WEBVIEW_PORT".to_string())
+        .or_insert_with(|| LINUX_CODEX_PLUSPLUS_WEBVIEW_PORT.to_string());
+    env.entry("CODEX_MULTI_LAUNCH_PORT_RANGE".to_string())
+        .or_insert_with(|| LINUX_CODEX_PLUSPLUS_MULTI_LAUNCH_PORT_RANGE.to_string());
+}
