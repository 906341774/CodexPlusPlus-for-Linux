+#[cfg(target_os = "linux")]
+fn hydrate_linux_network_environment_from_systemd(env: &mut HashMap<String, String>) {
+    let Ok(output) = std::process::Command::new("systemctl")
+        .args(["--user", "show-environment"])
+        .output()
+    else {
+        return;
+    };
+    if !output.status.success() {
+        return;
+    }
+    let contents = String::from_utf8_lossy(&output.stdout);
+    for line in contents.lines() {
+        import_linux_network_env_entry(env, line);
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn hydrate_linux_network_environment_from_processes(env: &mut HashMap<String, String>) {
+    let Ok(entries) = std::fs::read_dir("/proc") else {
+        return;
+    };
+    let uid = effective_uid();
+    for entry in entries.flatten() {
+        let file_name = entry.file_name();
+        let Some(pid) = file_name
+            .to_str()
+            .filter(|value| value.bytes().all(|byte| byte.is_ascii_digit()))
+        else {
+            continue;
+        };
+        if process_uid(pid).is_some_and(|process_uid| process_uid != uid) {
+            continue;
+        }
+        let environ_path = entry.path().join("environ");
+        let Ok(contents) = std::fs::read(environ_path) else {
+            continue;
+        };
+        let found_graphical_process = contents
+            .split(|byte| *byte == 0)
+            .any(|entry| entry.starts_with(b"DISPLAY=") || entry.starts_with(b"WAYLAND_DISPLAY="));
+        if !found_graphical_process {
+            continue;
+        }
+        for entry in contents.split(|byte| *byte == 0) {
+            if let Ok(entry) = std::str::from_utf8(entry) {
+                import_linux_network_env_entry(env, entry);
+            }
+        }
+        return;
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn process_uid(pid: &str) -> Option<u32> {
+    let status = std::fs::read_to_string(format!("/proc/{pid}/status")).ok()?;
+    status.lines().find_map(|line| {
+        let rest = line.strip_prefix("Uid:")?;
+        rest.split_whitespace().next()?.parse().ok()
+    })
+}
+
+#[cfg(target_os = "linux")]
+fn effective_uid() -> u32 {
+    process_uid("self").unwrap_or(u32::MAX)
+}
+
+#[cfg(target_os = "linux")]
+fn import_linux_network_env_entry(env: &mut HashMap<String, String>, entry: &str) {
+    let Some((name, value)) = entry.split_once('=') else {
+        return;
+    };
+    if !NETWORK_ENV_VARS.contains(&name) || value.is_empty() {
+        return;
+    }
+    env.entry(name.to_string())
+        .or_insert_with(|| value.to_string());
+}
