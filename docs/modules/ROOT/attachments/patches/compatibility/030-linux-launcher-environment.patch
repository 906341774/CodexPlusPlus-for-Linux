+pub fn codex_process_environment_from(
+    env: &HashMap<String, String>,
+    detect_system_proxy: impl FnOnce() -> Option<String>,
+) -> HashMap<String, String> {
+    let mut env = env.clone();
+    if cfg!(target_os = "linux") {
+        env.remove("ELECTRON_RUN_AS_NODE");
+        env.remove("ELECTRON_NO_ATTACH_CONSOLE");
+        for name in LINUX_RUNTIME_ENV_VARS {
+            env.remove(*name);
+        }
+        if should_hydrate_linux_network_environment(&env) {
+            hydrate_linux_network_environment(&mut env);
+        }
+    }
+    if crate::proxy::has_proxy_environment(&env) {
+        return env;
+    }
+    if let Some(proxy) = detect_system_proxy() {
+        env.insert("HTTPS_PROXY".to_string(), proxy.clone());
+        env.insert("HTTP_PROXY".to_string(), proxy);
+    }
+    env
+}
