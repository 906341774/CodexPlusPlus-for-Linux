+#[cfg(target_os = "linux")]
+fn hydrate_linux_network_environment(env: &mut HashMap<String, String>) {
+    hydrate_linux_network_environment_from_systemd(env);
+    hydrate_linux_network_environment_from_processes(env);
+}
+
+#[cfg(not(target_os = "linux"))]
+fn hydrate_linux_network_environment(_env: &mut HashMap<String, String>) {}
+
+#[cfg(target_os = "linux")]
+fn should_hydrate_linux_network_environment(env: &HashMap<String, String>) -> bool {
+    [
+        "DISPLAY",
+        "WAYLAND_DISPLAY",
+        "XDG_RUNTIME_DIR",
+        "DBUS_SESSION_BUS_ADDRESS",
+    ]
+    .into_iter()
+    .any(|name| env.get(name).is_some_and(|value| !value.is_empty()))
+}
+
+#[cfg(not(target_os = "linux"))]
+fn should_hydrate_linux_network_environment(_env: &HashMap<String, String>) -> bool {
+    false
