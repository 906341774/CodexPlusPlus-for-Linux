+        return failed(&format!("无法创建后台实例运行目录：{error}"), current);
+    }
+    #[cfg(unix)]
+    if let Err(error) = {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(&runtime, fs::Permissions::from_mode(0o700))
+    } {
+        return failed(&format!("无法保护后台实例运行目录：{error}"), current);
+    }
