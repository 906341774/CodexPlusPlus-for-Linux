+pub fn codex_process_environment_for_app(app_dir: &Path) -> HashMap<String, String> {
+    let env = std::env::vars().collect::<HashMap<_, _>>();
+    codex_process_environment_for_app_from(app_dir, &env, crate::proxy::detect_system_proxy)
+}
+
+pub fn codex_process_environment_for_app_from(
+    app_dir: &Path,
+    env: &HashMap<String, String>,
+    detect_system_proxy: impl FnOnce() -> Option<String>,
+) -> HashMap<String, String> {
+    let mut env = codex_process_environment_from(env, detect_system_proxy);
+    apply_linux_codex_plusplus_webview_environment(app_dir, &mut env);
+    env
+}
+
+const NETWORK_ENV_VARS: &[&str] = &[
+    "HTTP_PROXY",
+    "HTTPS_PROXY",
+    "ALL_PROXY",
+    "NO_PROXY",
+    "http_proxy",
+    "https_proxy",
+    "all_proxy",
+    "no_proxy",
+    "RES_OPTIONS",
+    "LOCALDOMAIN",
+    "HOSTALIASES",
+    "SSL_CERT_FILE",
+    "SSL_CERT_DIR",
+    "NODE_OPTIONS",
+];
+
+const LINUX_CODEX_PLUSPLUS_WEBVIEW_PORT: &str = "5176";
+const LINUX_CODEX_PLUSPLUS_MULTI_LAUNCH_PORT_RANGE: &str = "5176-5185";
+
+pub fn codex_process_environment_from(
+    env: &HashMap<String, String>,
+    detect_system_proxy: impl FnOnce() -> Option<String>,
+) -> HashMap<String, String> {
+    let mut env = env.clone();
+    if cfg!(target_os = "linux") {
+        env.remove("ELECTRON_RUN_AS_NODE");
+        env.remove("ELECTRON_NO_ATTACH_CONSOLE");
+        if should_hydrate_linux_network_environment(&env) {
+            hydrate_linux_network_environment(&mut env);
+        }
+    }
+    if crate::proxy::has_proxy_environment(&env) {
+        return env;
+    }
+    if let Some(proxy) = detect_system_proxy() {
+        env.insert("HTTPS_PROXY".to_string(), proxy.clone());
+        env.insert("HTTP_PROXY".to_string(), proxy);
+    }
+    env
+}
+
+#[cfg(target_os = "linux")]
+fn apply_linux_codex_plusplus_webview_environment(
+    app_dir: &Path,
+    env: &mut HashMap<String, String>,
+) {
+    if !app_dir.join("start.sh").exists() {
+        return;
+    }
+    env.entry("CODEX_WEBVIEW_PORT".to_string())
+        .or_insert_with(|| LINUX_CODEX_PLUSPLUS_WEBVIEW_PORT.to_string());
+    env.entry("CODEX_MULTI_LAUNCH_PORT_RANGE".to_string())
+        .or_insert_with(|| LINUX_CODEX_PLUSPLUS_MULTI_LAUNCH_PORT_RANGE.to_string());
+}
+
+#[cfg(not(target_os = "linux"))]
+fn apply_linux_codex_plusplus_webview_environment(
+    _app_dir: &Path,
+    _env: &mut HashMap<String, String>,
+) {
+}
+
+#[cfg(target_os = "linux")]
+fn hydrate_linux_network_environment(env: &mut HashMap<String, String>) {
+    hydrate_linux_network_environment_from_systemd(env);
+    hydrate_linux_network_environment_from_processes(env);
+}
+
+#[cfg(not(target_os = "linux"))]
+fn hydrate_linux_network_environment(_env: &mut HashMap<String, String>) {}
+
+#[cfg(target_os = "linux")]
+fn should_hydrate_linux_network_environment(env: &HashMap<String, String>) -> bool {
+    [
+        "DISPLAY",
+        "WAYLAND_DISPLAY",
+        "XDG_RUNTIME_DIR",
+        "DBUS_SESSION_BUS_ADDRESS",
+    ]
+    .into_iter()
+    .any(|name| env.get(name).is_some_and(|value| !value.is_empty()))
+}
+
+#[cfg(not(target_os = "linux"))]
+fn should_hydrate_linux_network_environment(_env: &HashMap<String, String>) -> bool {
+    false
+}
+
+#[cfg(target_os = "linux")]
+fn hydrate_linux_network_environment_from_systemd(env: &mut HashMap<String, String>) {
+    let Ok(output) = std::process::Command::new("systemctl")
+        .args(["--user", "show-environment"])
+        .output()
+    else {
+        return;
+    };
+    if !output.status.success() {
+        return;
+    }
+    let contents = String::from_utf8_lossy(&output.stdout);
+    for line in contents.lines() {
+        import_linux_network_env_entry(env, line);
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn hydrate_linux_network_environment_from_processes(env: &mut HashMap<String, String>) {
+    let Ok(entries) = std::fs::read_dir("/proc") else {
+        return;
+    };
+    let uid = effective_uid();
+    for entry in entries.flatten() {
+        let file_name = entry.file_name();
+        let Some(pid) = file_name
+            .to_str()
+            .filter(|value| value.bytes().all(|byte| byte.is_ascii_digit()))
+        else {
+            continue;
+        };
+        if process_uid(pid).is_some_and(|process_uid| process_uid != uid) {
+            continue;
+        }
+        let environ_path = entry.path().join("environ");
+        let Ok(contents) = std::fs::read(environ_path) else {
+            continue;
+        };
+        let found_graphical_process = contents
+            .split(|byte| *byte == 0)
+            .any(|entry| entry.starts_with(b"DISPLAY=") || entry.starts_with(b"WAYLAND_DISPLAY="));
+        if !found_graphical_process {
+            continue;
+        }
+        for entry in contents.split(|byte| *byte == 0) {
+            if let Ok(entry) = std::str::from_utf8(entry) {
+                import_linux_network_env_entry(env, entry);
+            }
+        }
+        return;
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn process_uid(pid: &str) -> Option<u32> {
+    let status = std::fs::read_to_string(format!("/proc/{pid}/status")).ok()?;
+    status.lines().find_map(|line| {
+        let rest = line.strip_prefix("Uid:")?;
+        rest.split_whitespace().next()?.parse().ok()
+    })
+}
+
+#[cfg(target_os = "linux")]
+fn effective_uid() -> u32 {
+    process_uid("self").unwrap_or(u32::MAX)
+}
+
+#[cfg(target_os = "linux")]
+fn import_linux_network_env_entry(env: &mut HashMap<String, String>, entry: &str) {
+    let Some((name, value)) = entry.split_once('=') else {
+        return;
+    };
+    if !NETWORK_ENV_VARS.contains(&name) || value.is_empty() {
+        return;
+    }
+    env.entry(name.to_string())
+        .or_insert_with(|| value.to_string());
+}
