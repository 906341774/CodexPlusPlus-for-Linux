+fn dedupe_paths(candidates: Vec<PathBuf>) -> Vec<PathBuf> {
+    let mut unique = Vec::new();
+    for candidate in candidates {
+        if !unique.iter().any(|path| path == &candidate) {
+            unique.push(candidate);
+        }
+    }
+    unique
