+#[cfg(target_os = "linux")]
+fn linux_adapter_app_dir_from_exe(exe: &Path) -> Option<PathBuf> {
+    let install_dir = exe.parent()?;
+    if install_dir.file_name().and_then(|name| name.to_str()) != Some("install") {
+        return None;
+    }
+    let state_dir = install_dir.parent()?;
+    if state_dir.file_name().and_then(|name| name.to_str()) != Some(".codex-plusplus") {
